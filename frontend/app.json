{
  "expo": {
    "name": "Pragati Path",
    "slug": "pragati-path",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pragatipath",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Upload payment screenshots and study materials",
        "NSCameraUsageDescription": "Capture photos for receipts and profiles"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "WAKE_LOCK"
      ]
    },
    "androidStatusBar": {
      "backgroundColor": "#0A1F3A",
      "barStyle": "light-content"
    },
    "notification": {
      "icon": "./assets/images/icon.png",
      "color": "#0A1F3A",
      "androidMode": "default",
      "androidCollapsedTitle": "Pragati Path"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0A1F3A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
